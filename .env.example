# Database Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# Flask Configuration
SECRET_KEY=your_secret_key_here
FLASK_ENV=development
PORT=5000

# WhatsApp / Logistics
LOGISTICS_PHONE_NUMBER=919999999999

# Tunneling (Cloudflare)
ENABLE_TUNNEL=True
# PUBLIC_URL will be auto-populated by the tunnel if enabled

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log
